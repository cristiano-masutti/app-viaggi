{
  "name": "app-viaggi-admin",
  "version": "1.0.0",
  "description": "Pannello di controllo dello staff Vibemakers Travel — React + Vite + Tailwind",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || >=24.3.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.55.0",
    "openapi-fetch": "^0.17.0",
    "react": "~19.2.3",
    "react-dom": "~19.2.3",
    "react-router": "^8.4.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
