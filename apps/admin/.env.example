# Copia in `.env.local`. Vite le scrive nel bundle: solo valori pubblici, mai
# segreti (niente service role key).

# Il backend (apps/backend). Deve ammettere l'origine del pannello in CORS_ORIGIN
# (in sviluppo http://localhost:5173).
VITE_API_URL=http://localhost:4000

# Supabase → Project Settings → API: URL del progetto e chiave publishable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY
