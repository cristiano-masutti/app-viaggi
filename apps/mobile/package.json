{
  "name": "app-viaggi",
  "version": "1.0.0",
  "description": "Prototipo frontend mobile Vibemakers Travel — React Native + Expo + NativeWind",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || >=24.3.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test": "jest",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.47.0",
    "nativewind": "^4.2.7",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@jest/globals": "^29.7.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "globalSetup": "<rootDir>/jest.global-setup.js"
  }
}
