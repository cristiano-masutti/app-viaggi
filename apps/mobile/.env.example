# Copia in `.env` per usare il backend vero. Senza queste tre variabili l'app
# parte in modalità prototipo, con i dati mock e il login finto.
#
# Expo le scrive nel bundle dell'app: qui vanno solo valori pubblici, mai
# segreti (niente service role key, niente password del database).

# Il backend (apps/backend). Da un telefono vero serve l'IP del computer nella
# rete locale, non localhost; dall'emulatore Android è http://10.0.2.2:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Supabase → Project Settings → API: l'URL del progetto e la chiave
# publishable (sb_publishable_…, o la vecchia anon key).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY
