# Copia in `.env` per lo sviluppo locale. In produzione le stesse variabili
# arrivano dalla piattaforma di deploy, mai da un file.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Origini web ammesse, separate da virgola (le app native non ne hanno bisogno).
CORS_ORIGIN=http://localhost:8081

# Postgres locale di docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_viaggi

# Serve sia allo storage sia al login: i token si verificano con le chiavi
# pubbliche di <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Il progetto deve
# usare le JWT Signing Keys asimmetriche (non il vecchio segreto HS256).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Bucket privato: i file si leggono solo tramite signed URL.
SUPABASE_STORAGE_BUCKET=trip-assets

# Facoltative.
# UPLOAD_MAX_BYTES=15728640
# SIGNED_URL_TTL_SECONDS=900
