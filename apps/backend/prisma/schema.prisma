generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Gli enum sono in minuscolo di proposito: sono gli stessi valori del modello
// del mobile (apps/mobile/src/types), dal database all'API senza traduzioni.

/**
 * ── Utenti ───────────────────────────────────────────────────────────
 */

/// Utente dell'app. L'id è quello di Supabase Auth (claim `sub`): la riga nasce
/// alla prima richiesta autenticata, senza una registrazione separata.
///
/// Il profilo è privato: lo legge solo il suo proprietario. Ai compagni di
/// viaggio arrivano nome, cognome e username, mai i dati qui sotto.
model User {
  id        String   @id @db.Uuid
  /// Copia di cortesia: la fonte di verità è Supabase. Può mancare (login via telefono).
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName    String  @default("")
  lastName     String  @default("")
  /// Minuscolo e senza '@': l'unicità non dipende da maiuscole e chiocciola.
  username     String? @unique
  bio          String  @default("")
  fiscalCode   String?
  diet         String  @default("")
  /// Dato sanitario (GDPR art. 9).
  medicalNotes String  @default("")

  /// Passaporto Master: uno per persona, riusato da tutti i viaggi.
  passportNumber    String?
  /// 'MM/AAAA', come stampato sul documento.
  passportExpiry    String?
  passportPhotoPath String?

  /// Staff dell'organizzazione: entra nel pannello di controllo e vede tutti i
  /// viaggi. Si concede solo da riga di comando (`npm run staff -- grant <email>`),
  /// mai dall'API: nessuna richiesta può promuovere qualcuno.
  isAdmin Boolean @default(false)

  memberships       TripMember[]
  invitationsSent   TripInvitation[]
  uploadedDocuments Document[]
  memories          Memory[]
  reactions         MemoryReaction[]
  events            AppEvent[]
}

/**
 * ── Viaggio e crew ───────────────────────────────────────────────────
 */

model Trip {
  id           String   @id @default(uuid()) @db.Uuid
  /// Comprensivo di emoji bandiera: "Islanda On The Road 🇮🇸".
  title        String
  destination  String?
  /// Solo data, senza orario: un viaggio è fatto di giorni (G1…Gn).
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  /// Posti totali del gruppo: oltre questo numero il link di invito non fa entrare.
  crewCapacity Int?
  /// Parte finale del link di invito. Non indovinabile: chi lo conosce entra.
  inviteCode   String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     TripMember[]
  invitations TripInvitation[]
  documents   Document[]
  stays       Stay[]
  activities  Activity[]
  transports  Transport[]
  insurance   Insurance?
  customs     Customs?
  emergencies EmergencyContact[]
  memories    Memory[]
  events      AppEvent[]
}

enum TripRole {
  /// Organizza il viaggio: programma, documenti, crew.
  coordinator
  /// Partecipa: vede tutto, pubblica ricordi, non modifica l'organizzazione.
  traveller
}

/// Chi fa parte di un viaggio e con quale ruolo. È l'unica fonte dei permessi:
/// senza una riga qui un utente non vede nemmeno che il viaggio esiste.
model TripMember {
  tripId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TripRole
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([userId])
}

/// Posto riservato a una persona che non è ancora entrata nel viaggio
/// ("invitato, non confermato"). Se chi entra col link ha la stessa email,
/// l'invito si chiude da solo.
model TripInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  tripId      String    @db.Uuid
  name        String
  /// Minuscola. Facoltativa: senza email l'invito si chiude solo a mano.
  email       String?
  invitedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tripId])
}

/**
 * ── Documenti (file) ─────────────────────────────────────────────────
 */

enum DocumentKind {
  pdf
  image
  /// Il contenuto è `code`: il QR si genera sul telefono, il file è facoltativo.
  qr
}

/// Un documento del viaggio (voucher, biglietto, polizza…). Si carica prima e
/// si collega poi a uno slot (alloggio, attività, mezzo…); `attached` impedisce
/// che lo stesso documento finisca in due posti. Quando lo slot lo sostituisce
/// o sparisce, il documento viene cancellato con il suo file.
model Document {
  id           String       @id @default(uuid()) @db.Uuid
  tripId       String       @db.Uuid
  /// `null` se l'utente che l'ha caricato è stato cancellato: il file resta al viaggio.
  uploadedById String?      @db.Uuid
  kind         DocumentKind
  title        String
  subtitle     String       @default("")
  /// Codice pratica mostrato nel viewer (voucher, biglietto, polizza…).
  code         String       @default("")
  attached     Boolean      @default(false)
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  /// Percorso nel bucket privato; `null` per un QR senza file.
  storagePath  String?      @unique
  createdAt    DateTime     @default(now())

  trip       Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  stay         Stay?
  activity     Activity?
  transportDoc TransportDoc?
  insurance    Insurance?
  customs      Customs?

  @@index([tripId])
}

/**
 * ── Programma del giorno ─────────────────────────────────────────────
 */

/// Alloggio del giorno `dayIndex` (1 = primo giorno). Al massimo uno per giorno.
model Stay {
  tripId     String   @db.Uuid
  dayIndex   Int
  name       String
  address    String
  documentId String?  @unique @db.Uuid
  updatedAt  DateTime @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@id([tripId, dayIndex])
}

model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @db.Uuid
  dayIndex   Int
  name       String
  place      String
  /// Ordine nella giornata: le nuove attività vanno in fondo.
  position   Int
  documentId String?  @unique @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tripId, dayIndex])
}

/**
 * ── Documenti fissi del viaggio ──────────────────────────────────────
 */

enum TransportMode {
  van
  flight
  ferry
}

model Transport {
  id        String        @id @default(uuid()) @db.Uuid
  tripId    String        @db.Uuid
  name      String
  /// Targa, numero volo, molo e orario.
  reference String        @default("")
  mode      TransportMode
  position  Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  trip Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  docs TransportDoc[]

  @@index([tripId])
}

/// Un documento di un mezzo: contratto di noleggio, carta d'imbarco, kasko…
model TransportDoc {
  id          String  @id @default(uuid()) @db.Uuid
  transportId String  @db.Uuid
  label       String
  position    Int
  documentId  String? @unique @db.Uuid

  transport Transport @relation(fields: [transportId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([transportId])
}

model Insurance {
  tripId         String   @id @db.Uuid
  company        String
  policy         String
  coverage       String   @default("")
  emergencyPhone String   @default("")
  documentId     String?  @unique @db.Uuid
  updatedAt      DateTime @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}

/// Modulo doganale o di ingresso del viaggio.
model Customs {
  tripId     String   @id @db.Uuid
  code       String
  note       String   @default("")
  documentId String?  @unique @db.Uuid
  updatedAt  DateTime @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}

/// Card SOS del viaggio, nell'ordine in cui vanno mostrate.
model EmergencyContact {
  id          String  @id @default(uuid()) @db.Uuid
  tripId      String  @db.Uuid
  title       String
  subtitle    String  @default("")
  actionLabel String
  /// Già normalizzato per `tel:`.
  phone       String
  whatsapp    Boolean @default(false)
  position    Int

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

/**
 * ── Ricordi ──────────────────────────────────────────────────────────
 */

enum MemoryKind {
  photo
  video
  note
}

enum MemoryVisibility {
  /// Visibile a tutta la crew.
  crew
  /// Visibile solo a chi l'ha pubblicato.
  private
}

enum NoteMood {
  anecdote
  place
  thought
  personal
}

enum Reaction {
  fire
  laugh
  love
  mindblown
}

model Memory {
  id         String           @id @default(uuid()) @db.Uuid
  tripId     String           @db.Uuid
  authorId   String           @db.Uuid
  dayIndex   Int
  kind       MemoryKind
  visibility MemoryVisibility
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Foto e video
  storagePath     String? @unique
  mimeType        String?
  sizeBytes       Int?
  caption         String?
  blurhash        String?
  /// Larghezza / altezza, nota prima del download: la griglia non salta.
  aspectRatio     Float?
  durationSeconds Int?

  // Note di diario
  text String?
  mood NoteMood?

  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions MemoryReaction[]

  @@index([tripId, createdAt])
}

/// Una reazione per persona per ricordo: la nuova sostituisce la precedente.
model MemoryReaction {
  memoryId  String   @db.Uuid
  userId    String   @db.Uuid
  reaction  Reaction
  createdAt DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([memoryId, userId])
}

/**
 * ── Metriche d'uso ───────────────────────────────────────────────────
 */

enum AppEventName {
  /// L'app si apre, o torna in primo piano, con una sessione attiva.
  app_open
  /// Una schermata vista: `screen` dice quale.
  screen_view
  /// Un documento aperto nel viewer (voucher, biglietto, polizza…).
  document_open
}

enum AppPlatform {
  ios
  android
  web
}

/// Un evento d'uso dell'app, per le metriche del pannello. Niente contenuti:
/// chi, cosa, su quale viaggio, quando. Si cancellano dopo qualche mese
/// (`npm run telemetry:prune`).
model AppEvent {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  /// Il viaggio a cui si riferisce: solo se chi lo manda è nella crew.
  tripId     String?      @db.Uuid
  name       AppEventName
  /// Per `screen_view`: il nome della schermata (es. `TripDetail`).
  screen     String?
  platform   AppPlatform
  appVersion String?
  /// Quando è successo sul telefono, ricondotto a un intervallo plausibile.
  occurredAt DateTime
  receivedAt DateTime     @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([tripId, occurredAt])
}

enum TelemetrySource {
  /// L'app mobile.
  app
  /// Il pannello di controllo dello staff.
  panel
}

enum PerfMetric {
  /// App: dall'avvio del codice alla prima schermata pronta (ms).
  app_start
  /// App: da quando si apre una schermata a quando mostra i dati (ms).
  screen_ready
  /// App e pannello: durata di una chiamata all'API vista dal client (ms).
  api_latency
  /// App: fotogrammi lenti (oltre 2 frame) in una finestra di 10 secondi (%).
  slow_frames
  /// App: blocchi oltre 700 ms in una finestra di 10 secondi (numero).
  frozen_frames
  /// Pannello, Web Vitals: Largest Contentful Paint (ms).
  lcp
  /// Pannello, Web Vitals: Interaction to Next Paint (ms).
  inp
  /// Pannello, Web Vitals: Cumulative Layout Shift (punteggio).
  cls
  /// Pannello, Web Vitals: Time To First Byte (ms).
  ttfb
}

/// Un campione di prestazioni: quanto ci ha messo una cosa, su quale
/// schermata o chiamata. Anonimo: serve a vedere come va il prodotto, non chi.
model PerfSample {
  id         String          @id @default(uuid()) @db.Uuid
  source     TelemetrySource
  platform   AppPlatform
  appVersion String?
  metric     PerfMetric
  /// Schermata dell'app, pagina del pannello o chiamata (`GET /api/trips/{tripId}`).
  target     String?
  value      Float
  occurredAt DateTime
  receivedAt DateTime        @default(now())

  @@index([metric, occurredAt])
}
