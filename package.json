{
  "name": "app-viaggi-monorepo",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || >=24.3.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:web": "npm --prefix apps/mobile run web",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile test",
    "mobile:api-types": "npm --prefix apps/mobile run api:types",
    "mobile:doctor": "npm --prefix apps/mobile run doctor",
    "admin:install": "npm --prefix apps/admin install",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:test": "npm --prefix apps/admin test",
    "admin:verify": "npm --prefix apps/admin run verify",
    "admin:api-types": "npm --prefix apps/admin run api:types",
    "e2e:install": "npm --prefix e2e install",
    "e2e:build": "npm --prefix e2e run build",
    "e2e:test": "npm --prefix e2e test",
    "e2e:report": "npm --prefix e2e run report",
    "backend:install": "npm --prefix apps/backend install",
    "backend:db:up": "docker compose -f apps/backend/docker-compose.yml up -d --wait",
    "backend:dev": "npm --prefix apps/backend run dev",
    "backend:build": "npm --prefix apps/backend run build",
    "backend:test": "npm --prefix apps/backend test",
    "backend:verify": "npm --prefix apps/backend run verify",
    "backend:openapi": "npm --prefix apps/backend run openapi",
    "backend:staff": "npm --prefix apps/backend run staff --",
    "backend:seed:demo": "npm --prefix apps/backend run seed:demo",
    "backend:prisma:generate": "npm --prefix apps/backend run prisma:generate",
    "backend:prisma:migrate": "npm --prefix apps/backend run prisma:migrate"
  }
}
